# Backend environment — copy to backend/.env for local development.
# NEVER commit a filled-in .env. Production values go into Render's dashboard.

NODE_ENV=development
PORT=5000

# Neon free PostgreSQL (pooled connection string, SSL included)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Exact browser origins, comma-separated. Cloudflare production + custom domain.
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=https://your-app.pages.dev,https://your-custom-domain.com

# Brevo HTTP API (no SMTP ports, no mail relay)
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=MATE ZONE Chess Academy
# Local-only: MAIL_TRANSPORT=dummy prints mail instead of sending it.

# Cloudinary uploads (or use CLOUDINARY_URL=cloudinary://key:secret@cloud)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=mate-zone

# Keep the review-analysis worker tiny on free hosts
ANALYSIS_ENGINE_POOL=1

# Existing optional integrations (leave empty if unused)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GAME_HISTORY_RETENTION_DAYS=
GAME_HISTORY_RUN_INTERVAL_MS=
