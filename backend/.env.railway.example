# Paste these keys into Railway → your service → Variables → Raw Editor.
# Values must come from your local backend/.env (this file is a template only).
# Do NOT set PORT or DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME on Railway:
# Railway provides PORT and the Postgres service reference below.

DATABASE_URL=${{Postgres.DATABASE_URL}}

JWT_SECRET=
JWT_EXPIRES_IN=
CLIENT_URL=https://your-vercel-app.vercel.app
FRONTEND_URL=https://your-vercel-app.vercel.app

GAME_HISTORY_RETENTION_DAYS=
GAME_HISTORY_RUN_INTERVAL_MS=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Railway Hobby blocks outbound SMTP (25/465/587), so the API sends through
# the Vercel function in frontend/api/mail-relay.js instead. The SMTP
# credentials themselves live in the Vercel project's env vars.
# Run `node scripts/configure-mail-relay.mjs` to set all of this idempotently.
MAIL_TRANSPORT=relay
MAIL_RELAY_URL=https://your-vercel-app.vercel.app/api/mail-relay
MAIL_RELAY_SECRET=

# Only if you move to a host that allows SMTP (e.g. Railway Pro):
# MAIL_HOST=
# MAIL_PORT=
# MAIL_USER=
# MAIL_PASS=
# MAIL_FROM=
# MAIL_FROM_NAME=
# MAIL_SECURE=

# Optional: the Python diagram/game analysis helper is not shipped to Railway.
# Leave these out unless you add a Python build step.
# PYTHON_BIN=
# DIAGRAM_READER_LOCAL=
# DIAGRAM_READER_MODEL_FILE=
# DIAGRAM_READER_MAX_IMAGE_MB=
