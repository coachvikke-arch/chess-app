# Frontend build environment — copy to frontend/.env for local work.
# On Cloudflare Pages put these in Settings → Environment Variables.
# VITE_* values are baked into the bundle at BUILD time; rebuild after a change.

NODE_VERSION=20

# Render backend origin, WITHOUT a trailing /api.
VITE_API_URL=http://localhost:5000
# Socket.IO must reach Render directly; Cloudflare Pages cannot proxy WebSockets.
VITE_SOCKET_URL=http://localhost:5000
# Only needed for legacy /uploads/... rows; use the Render backend origin.
VITE_UPLOAD_BASE_URL=http://localhost:5000

# Full review network (~94.6 MB) cannot be a Cloudflare Pages asset (25 MiB cap).
# Upload it to a CORS-enabled host and paste the direct file URL here.
VITE_REVIEW_WASM_URL=
SKIP_FULL_WASM=1
